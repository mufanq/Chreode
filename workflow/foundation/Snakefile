def runtime_hms(minutes):
    minutes = int(minutes)
    return f"{minutes // 60:02d}:{minutes % 60:02d}:00"


def mem_mb_to_slurm(mem_mb):
    return f"{int(mem_mb)}M"


def sbatch_wait(job_name, partition, runtime_min, cpus, mem_mb, stdout, stderr, command,
                gres="gpu:1", qos=None, metadata=None):
    parts = [
        "python scripts/slurm/sbatch_wait.py",
        f"--job-name {job_name}",
        f"--partition {partition}",
        f"--time {runtime_hms(runtime_min)}",
        f"--cpus {int(cpus)}",
        f"--mem {mem_mb_to_slurm(mem_mb)}",
        f"--output {stdout}",
        f"--error {stderr}",
    ]
    if gres:
        parts.append(f"--gres {gres}")
    if qos:
        parts.append(f"--qos {qos}")
    if metadata:
        parts.append(f"--metadata {metadata}")
    parts.append(f"--cmd {shlex.quote(command)}")
    return " ".join(parts)


def wandb_args(job_name, tags_extra=""):
    if not WANDB_CFG.get("enabled", False):
        return ""
    args = [
        "--wandb",
        f"--wandb-project {WANDB_CFG.get('project', 'CellWorldModel')}",
        f"--wandb-group {WANDB_CFG.get('group', 'foundation_genhui_v1')}",
        f"--wandb-name {job_name}",
        f"--wandb-mode {WANDB_CFG.get('mode', 'online')}",
    ]
    entity = WANDB_CFG.get("entity")
    if entity:
        args.append(f"--wandb-entity {entity}")
    tags = WANDB_CFG.get("tags")
    if tags_extra:
        tags = f"{tags},{tags_extra}" if tags else tags_extra
    if tags:
        args.append(f"--wandb-tags {tags}")
    return " ".join(args)


def vae_arch_command(wc):
    item = VAE_ARCH_SEARCH[wc.name]
    return (
        "source 3rdparty/BranchSBM/.branchsbm-venv/bin/activate && "
        "export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True} && "
        "PYTHONPATH=src python -m cellworldmodel.script.run_foundation train-vae-smoke "
        f"--config {CONFIGFILE_PATH} "
        f"--catalog-dir {OUT_ROOT}/catalog "
        f"--output-dir {OUT_ROOT}/vae/arch_{wc.name} "
        f"--architecture {item['architecture']} "
        f"--latent-dim {item['latent_dim']} "
        f"--batch-strategy {item.get('batch_strategy', 'b1_leaf_dataset')} "
        f"--max-steps {item['steps']} "
        f"--batch-size {item['batch_size']} "
        f"--qc-sample-size {VAE_CFG.get('qc_sample_size', 2048)} "
        "--seed 0 "
        f"{wandb_args(f'foundation-vae-arch-{wc.name}', tags_extra='vae_arch_search')}"
    )


