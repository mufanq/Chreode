def perturbation_command(name, init_name, output_dir, init_checkpoint=""):
    extra_init = f"--init-checkpoint {init_checkpoint}" if init_checkpoint else ""
    allow_unknown = "--allow-unknown-batch" if bool(PERT_CFG.get("allow_unknown_batch", False)) else ""
    return (
        "source 3rdparty/BranchSBM/.branchsbm-venv/bin/activate && "
        "export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True} && "
        "PYTHONPATH=src python -m cellworldmodel.script.run_foundation train-perturbation-finetune "
        f"--config {CONFIGFILE_PATH} "
        f"--catalog-dir {OUT_ROOT}/catalog "
        f"--output-dir {output_dir} "
        f"--name {name} "
        f"--init-name {init_name} "
        f"--norman-path {PERT_CFG.get('norman_path', '3rdparty/scDFM/data/norman/norman.h5ad')} "
        f"--vae-checkpoint {VAE_FULL_DIR}/epoch_{VAE_FULL_EPOCHS}.pt "
        f"{extra_init} "
        f"--experiment {DYNAMICS_EXPERIMENT} "
        f"--dit-size {DYNAMICS_DIT_SIZE} "
        f"--max-steps {PERT_CFG.get('max_steps', 1000)} "
        f"--batch-size {PERT_CFG.get('batch_size', 256)} "
        f"--k-samples {DYNAMICS_K} "
        f"--action-dim {PERT_CFG.get('action_dim', 64)} "
        f"--action-encoder {PERT_CFG.get('action_encoder', 'geneset_deepset_v1')} "
        f"--lr {DYNAMICS_LR} "
        f"--split-method {PERT_CFG.get('split_method', 'additive')} "
        f"--eval-every {PERT_CFG.get('eval_every', 200)} "
        f"{allow_unknown} "
        "--seed 0 "
        f"{wandb_args(f'foundation-perturb-{name}', tags_extra='foundation_perturbation')}"
    )


def perturbation_baseline_command():
    return (
        "source 3rdparty/BranchSBM/.branchsbm-venv/bin/activate && "
        "PYTHONPATH=src python -m cellworldmodel.script.run_foundation run-perturbation-baselines "
        f"--config {CONFIGFILE_PATH} "
        f"--catalog-dir {OUT_ROOT}/catalog "
        f"--output-dir {PERTURB_BASELINE_DIR} "
        f"--norman-path {PERT_CFG.get('norman_path', '3rdparty/scDFM/data/norman/norman.h5ad')} "
        f"--vae-checkpoint {VAE_FULL_DIR}/epoch_{VAE_FULL_EPOCHS}.pt "
        f"--dynamics-checkpoint {DYNAMICS_TEMPORAL_DIR}/model.pt "
        f"--split-method {PERT_CFG.get('split_method', 'additive')} "
        f"--max-cells-per-condition {PERT_CFG.get('baseline_max_cells_per_condition', 512)} "
        f"--eval-cells-per-condition {PERT_CFG.get('baseline_eval_cells_per_condition', 256)} "
        "--device cuda"
    )


def gears_init_name(arm):
    if arm == "vae2_staticdit2":
        return "static_dit"
    if arm == "vae2_dynamicsdit2":
        return "temporal_dynamics"
    return "random"


def gears_init_checkpoint(arm):
    if arm == "vae2_staticdit2":
        return f"{DYNAMICS_STATIC_DIR}/model.pt"
    if arm == "vae2_dynamicsdit2":
        return f"{DYNAMICS_TEMPORAL_DIR}/model.pt"
    return ""


def gears_downstream_command(arm, model_type="direct_action", output_dir=None):
    init_checkpoint = gears_init_checkpoint(arm)
    extra_init = f"--init-checkpoint {init_checkpoint}" if init_checkpoint else ""
    output_dir = output_dir or f"{GEARS_DOWNSTREAM_DIR}/{arm}"
    direction_arg = (
        f"--direction-weight {PERT_CFG['gears_direction_weight']} "
        if "gears_direction_weight" in PERT_CFG else ""
    )
    return (
        f"PYTHONPATH=src {GEARS_DOWNSTREAM_PYTHON} -m cellworldmodel.script.run_foundation train-gears-downstream "
        f"--config {CONFIGFILE_PATH} "
        f"--gears-adata {GEARS_ADATA} "
        f"--split {GEARS_SPLIT} "
        f"--subgroup {GEARS_SUBGROUP} "
        f"--gene-vocab {OUT_ROOT}/catalog/gene_vocab.parquet "
        f"--vae-checkpoint {VAE_FULL_DIR}/epoch_{VAE_FULL_EPOCHS}.pt "
        f"{extra_init} "
        f"--init-name {gears_init_name(arm)} "
        f"--output-dir {output_dir} "
        f"--experiment {DYNAMICS_EXPERIMENT} "
        f"--dit-size {DYNAMICS_DIT_SIZE} "
        f"--max-steps {PERT_CFG.get('gears_downstream_steps', 1000)} "
        f"--batch-size {PERT_CFG.get('gears_downstream_batch_size', 256)} "
        f"--k-samples {DYNAMICS_K} "
        f"--action-dim {PERT_CFG.get('action_dim', 64)} "
        f"--lr {PERT_CFG.get('gears_downstream_lr', DYNAMICS_LR)} "
        f"--latent-weight {PERT_CFG.get('gears_latent_weight', 0.1)} "
        f"--expr-weight {PERT_CFG.get('gears_expr_weight', 1.0)} "
        f"--de-weight {PERT_CFG.get('gears_de_weight', 2.0)} "
        f"--delta-weight {PERT_CFG.get('gears_delta_weight', 0.2)} "
        f"{direction_arg}"
        f"--model-type {model_type} "
        "--device cuda"
    )


def gears_foundation_embedding_source(arm):
    if arm == "vae":
        return "vae"
    if arm == "static":
        return "static_dit"
    if arm == "dynamics":
        return "dynamics_dit"
    raise ValueError(f"Unknown GEARS foundation embedding arm: {arm}")


def gears_foundation_embedding_dynamics_arg(arm):
    if arm == "static":
        return f"--dynamics-checkpoint {DYNAMICS_STATIC_DIR}/model.pt "
    if arm == "dynamics":
        return f"--dynamics-checkpoint {DYNAMICS_TEMPORAL_DIR}/model.pt "
    return ""


def gears_foundation_embedding_command(arm):
    out = f"{GEARS_FOUNDATION_EMB_PREFIX}_{arm}_{GEARS_FOUNDATION_EMB_MODE}{GEARS_FOUNDATION_EMB_EPOCHS}"
    return (
        f"PYTHONPATH=src {GEARS_VENV_PYTHON} scripts/gears/run_norman_gears_foundation_emb.py "
        f"--gears-repo 3rdparty/GEARS "
        f"--data-dir {GEARS_DATA_DIR} "
        f"--output-dir {out} "
        f"--data-name norman "
        f"--split simulation "
        f"--seed 1 "
        f"--epochs {GEARS_FOUNDATION_EMB_EPOCHS} "
        f"--batch-size {GEARS_CFG.get('foundation_embedding_batch_size', 32)} "
        f"--test-batch-size {GEARS_CFG.get('foundation_embedding_test_batch_size', 128)} "
        f"--hidden-size {GEARS_CFG.get('foundation_embedding_hidden_size', 64)} "
        f"--lr {GEARS_CFG.get('foundation_embedding_lr', 1e-3)} "
        f"--device cuda:0 "
        f"--gene-vocab {OUT_ROOT}/catalog/gene_vocab.parquet "
        f"--vae-checkpoint {VAE_FULL_DIR}/epoch_{VAE_FULL_EPOCHS}.pt "
        f"--foundation-source {gears_foundation_embedding_source(arm)} "
        f"--foundation-mode {GEARS_FOUNDATION_EMB_MODE} "
        f"--foundation-k-samples {GEARS_CFG.get('foundation_embedding_k_samples', 2)} "
        f"--foundation-embed-batch-size {GEARS_CFG.get('foundation_embedding_embed_batch_size', 512)} "
        f"{gears_foundation_embedding_dynamics_arg(arm)}"
        f"--save-test-res && "
        f"PYTHONPATH=src {GEARS_VENV_PYTHON} -m cellworldmodel.script.run_foundation eval-gears-shared-vocab "
        f"--gears-adata {GEARS_ADATA} "
        f"--gears-test-res {out}/test_res.pkl "
        f"--ours-genes {OUT_ROOT}/catalog/gene_vocab.parquet "
        f"--subgroup {GEARS_SUBGROUP} "
        f"--output-dir {out}/shared_eval"
    )


