)
vae_arch_outputs = expand(
    f"{OUT_ROOT}/vae/arch_{{name}}/qc.json",
    name=list(VAE_ARCH_SEARCH.keys()),
)
vae_arch_eval_outputs = expand(
    f"{OUT_ROOT}/vae/arch_{{name}}/embedding_eval/metrics.json",
    name=list(VAE_ARCH_SEARCH.keys()),
)


