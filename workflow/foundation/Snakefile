    f"{OUT_ROOT}/vae/smoke_{{strategy}}_latent{{latent_dim}}/qc.json",
    strategy=VAE_SMOKE_BATCH_STRATEGIES,
    latent_dim=VAE_LATENT_DIMS,
)
vae_throughput_outputs = expand(
    f"{OUT_ROOT}/vae/throughput_{{strategy}}_latent{{latent_dim}}_batch{{batch_size}}/qc.json",
